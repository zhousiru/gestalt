{
  "name": "@gestalt/harness",
  "version": "0.0.0",
  "private": true,
  "description": "Replay, simulators, fixtures, eval suites, trace assertions, and reports.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "verify": "tsx src/life.verify.ts",
    "verify:life": "tsx src/life.verify.ts",
    "verify:migrate": "tsx src/migrate.verify.ts",
    "verify:wake-model": "tsx src/wakeModel.verify.ts",
    "verify:soul": "tsx src/soul.eval.ts",
    "verify:inspect": "tsx src/inspect.verify.ts",
    "verify:onebot": "tsx src/onebotProtocol.verify.ts",
    "verify:config": "tsx src/config.verify.ts",
    "verify:eval-config": "tsx src/evalModelConfig.verify.ts",
    "verify:prompts": "tsx src/promptCatalog.verify.ts",
    "verify:app-config": "tsx src/appHostConfig.verify.ts",
    "verify:model-config": "tsx src/modelConfig.verify.ts",
    "verify:stickers": "tsx src/stickers.verify.ts",
    "verify:sticker-media": "tsx src/stickerMedia.verify.ts",
    "verify:stickers-ui": "tsx src/liveStickersUi.verify.ts",
    "verify:traces-ui": "tsx src/tracesUi.verify.ts",
    "verify:artifact-binary": "tsx src/artifactBinary.verify.ts",
    "preview:traces-ui": "tsx src/tracesUi.verify.ts --hold",
    "preview:stickers-ui": "tsx src/liveStickersUi.verify.ts --hold",
    "verify:build": "tsx src/liveUiBuild.verify.ts",
    "eval": "tsx src/eval.ts && tsx src/onebotProtocol.eval.ts",
    "eval:life": "tsx src/eval.ts",
    "eval:soul": "tsx src/soul.eval.ts",
    "replay:journal": "tsx src/journalReplay.ts",
    "eval:onebot": "tsx src/onebotProtocol.eval.ts",
    "eval:stickers": "tsx src/stickersSocial.eval.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gestalt/app": "workspace:*",
    "@gestalt/live-contracts": "workspace:*",
    "ai": "^7.0.16",
    "dotenv": "^17.4.2",
    "sharp": "^0.35.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
