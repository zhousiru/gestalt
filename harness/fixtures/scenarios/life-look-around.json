{
  "start": "2026-11-05T06:00:00.000Z",
  "id": "life-look-around",
  "description": "Inside a place the bot can scroll back, search, and open a specific message.",
  "configOverrides": "life_unread_limit = 2\ncontext_recent_message_count = 0",
