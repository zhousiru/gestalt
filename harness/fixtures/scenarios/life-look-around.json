      [
        {
          "tool": "sleep",
          "input": {
            "seconds": 600
          }
        }
      ],
      [
        {
          "tool": "look",
          "input": {
            "place": "group-g1"
          }
        },
        {
          "tool": "look",
          "input": {
            "before": "m3"
          }
        },
        {
          "tool": "look",
          "input": {
            "search": "冰淇淋"
          }
        },
        {
          "tool": "look",
          "input": {
            "message_id": "m1"
          }
        },
        {
          "tool": "sleep",
          "input": {
            "seconds": 7200
          }
        }
      ]
    ]
  },
  "events": [
    {
